# JARVIS main model: Qwen3 8B (Q4_K_M, about 5.2 GB). Build: ollama create jarvis-worker8 -f scripts/Modelfile.jarvis-worker8
# Sized for an 8 GB GPU shared with Whisper, the desktop and a wallpaper: 8192-token window, q8 KV cache (set OLLAMA_KV_CACHE_TYPE=q8_0).
FROM qwen3:8b
PARAMETER num_ctx 8192
PARAMETER num_gpu 99
PARAMETER temperature 0.3
PARAMETER top_k 20
PARAMETER top_p 0.9
PARAMETER presence_penalty 1.0
