{
  "manifest_version": 3,
  "name": "JARVIS for YouTube Music",
  "version": "1.3.0",
  "description": "Lets JARVIS (running on this PC) search, play and queue songs in your YouTube Music tab. Talks only to 127.0.0.1.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["tracker.js", "logger-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["logger-relay.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "JARVIS for YouTube Music",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
